<mxfile host="drawio" type="device"><diagram id="seo-agent-flows" name="The SEO agent: data in, drafts out, a person decides"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" page="0" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="The SEO agent: data in, drafts out, a person decides" style="text;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="sched" value="Schedules (UTC)&#10;or Run now / MCP" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="60" as="geometry"/></mxCell><mxCell id="sync" value="Sync flows&#10;Search Console, GA4,&#10;DataForSEO" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="40" width="180" height="80" as="geometry"/></mxCell><mxCell id="data" value="SEO data&#10;(PostgreSQL)" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="50" width="150" height="70" as="geometry"/></mxCell><mxCell id="rules" value="Rules + ML models&#10;scoring, decay, intent,&#10;clusters, related" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="40" width="190" height="80" as="geometry"/></mxCell><mxCell id="recs" value="Recommendations,&#10;reports, alerts" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="55" width="170" height="60" as="geometry"/></mxCell><mxCell id="opt" value="optimize_article_flow /&#10;new_article_flow&#10;(Claude crews)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="200" height="80" as="geometry"/></mxCell><mxCell id="drafts" value="Drafts&#10;ready for review" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="200" width="160" height="60" as="geometry"/></mxCell><mxCell id="gate" value="Human&#10;approval" style="rhombus;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="180" width="130" height="100" as="geometry"/></mxCell><mxCell id="pub" value="publish_flow&#10;publish + submit" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="330" width="170" height="60" as="geometry"/></mxCell><mxCell id="budget" value="Budgets and kill switches&#10;(Automation &amp; AI)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="200" width="200" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sched" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sync" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="data" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rules" target="recs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="worth fixing" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rules" target="opt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="opt" target="drafts"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="drafts" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="approved on the site only" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="caps" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="budget" target="opt"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>