<mxfile host="drawio" type="device"><diagram id="publishing-workflow" name="From idea to published article"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" page="0" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="From idea to published article" style="text;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="idea" value="Idea / calendar item&#10;(Suggested -&gt; Approved)" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="200" height="60" as="geometry"/></mxCell><mxCell id="draft" value="Draft in the editor&#10;(Visual or Markdown)" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="180" height="60" as="geometry"/></mxCell><mxCell id="review" value="Status: review" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="140" height="60" as="geometry"/></mxCell><mxCell id="pub" value="Publish&#10;(button or&#10;scheduled)" style="rhombus;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="50" width="140" height="100" as="geometry"/></mxCell><mxCell id="live" value="Published&#10;sitemap, feeds, IndexNow" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="70" width="200" height="60" as="geometry"/></mxCell><mxCell id="ai" value="AI draft&#10;(SEO agent or News desk)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="230" width="180" height="60" as="geometry"/></mxCell><mxCell id="queue" value="Review queue&#10;(diff, notes)" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="140" height="60" as="geometry"/></mxCell><mxCell id="approve" value="Approve?" style="rhombus;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="140" height="100" as="geometry"/></mxCell><mxCell id="reject" value="Rejected / revise&#10;(nothing changes)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="290" width="200" height="55" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="idea" target="draft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="draft" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="review" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="person" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pub" target="live"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ai" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="queue" target="approve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="approve = publish + submit" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="approve" target="live"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="no" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="approve" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>