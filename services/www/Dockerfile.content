# syntax=docker/dockerfile:1
# Content image: only content/ (MDX) and public/images/ (diagrams, screenshots). No Node, no build.
# Built and pushed by .github/workflows/ci-content.yml as registry.jithendar.com/jithendar/jithendar-content:latest.
#
# The site Deployment (minikube/30-jithendar-com.yaml) runs this image as init container "content": it copies both
# folders into emptyDirs mounted at /app/content and /app/public/images in the web container, so a content-only
# change ships without rebuilding jithendar-com. busybox only provides `cp`.
#
#   docker build --platform linux/arm64 -f Dockerfile.content -t jithendar-content .   (run from services/www/)
FROM busybox:1.37.0
COPY --chown=1000:1000 content /content
COPY --chown=1000:1000 public/images /images
USER 1000:1000
CMD ["sh", "-c", "cp -a /content/. /mnt/content/ && cp -a /images/. /mnt/images/"]
