{
  "id": null,
  "uid": "jithendar-com-seo-agent",
  "title": "Jithendar.com \u00b7 SEO agents",
  "description": "SEO v3 (services/seo-agent): LangGraph runs, the editorial crew, embeddings and Ask the Blog. Source: jithendar.com repository, services/grafana/.",
  "tags": [
    "jithendar-com",
    "prometheus",
    "seo"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Waiting for review",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "max(seo_graph_interrupts_pending{job=\"seo-agent\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LLM budget used (month, v2+v3)",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "max(seo_llm_budget_used_ratio{job=\"seo-agent\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
