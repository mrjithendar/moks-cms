      "title": "Ask the Blog budget used (today)",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "max(seo_ask_budget_used_ratio{job=\"seo-agent\"})"
        }
