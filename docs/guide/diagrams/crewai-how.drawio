<mxfile host="drawio" type="device"><diagram id="crewai-how" name="How CrewAI works here: a flow runs a crew"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" page="0" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="How CrewAI works here: a flow runs a crew" style="text;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="trigger" value="Schedule, Run now&#10;or MCP" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="prep" value="Flow: plain steps&#10;fetch article, read numbers" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="70" width="210" height="80" as="geometry"/></mxCell><mxCell id="a1" value="Agent 1&#10;analyst / researcher" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="180" height="55" as="geometry"/></mxCell><mxCell id="a2" value="Agent 2&#10;editor / writer" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="125" width="180" height="55" as="geometry"/></mxCell><mxCell id="a3" value="Agent 3&#10;technical reviewer" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="210" width="180" height="55" as="geometry"/></mxCell><mxCell id="tools" value="Read-only tools&#10;articles, search data,&#10;official docs" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="180" height="80" as="geometry"/></mxCell><mxCell id="check" value="Flow checks the result&#10;(limits, format, numbers)" style="rounded=1;fillColor=#ffffff;st