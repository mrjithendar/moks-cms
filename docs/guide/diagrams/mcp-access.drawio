<mxfile host="drawio" type="device"><diagram id="mcp-access" name="MCP: AI assistants on the SEO tools"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" page="0" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MCP: AI assistants on the SEO tools" style="text;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="claude" value="Claude (phone / desktop)&#10;or MCP Inspector" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="210" height="60" as="geometry"/></mxCell><mxCell id="consent" value="Consent page on the site&#10;(sign in as admin, pick scopes)" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="230" height="70" as="geometry"/></mxCell><mxCell id="admin" value="Admin MCP server&#10;OAuth 2.1 + PKCE&#10;switch ADMIN_MCP_ENABLED" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="230" height="90" as="geometry"/></mxCell><mxCell id="scopes" value="Scopes&#10;seo:read, seo:flows,&#10;seo:review:reject" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="50" width="190" height="90" as="geometry"/></mxCell><mxCell id="never" value="Never: approve, publish,&#10;roll back, submit" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="200" width="190" height="60" as="geometry"/></mxCell><mxCell id="revoke" value="Settings -&gt; MCP&#10;lists clients, Revoke" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="230" height="60" as="geometry"/></mxCell><mxCell id="readers" value="Readers&#x27; assistants" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="210" height="50" as="geometry"/></mxCell><mxCell id="public" value="Public MCP server&#10;published articles only&#10;switch PUBLIC_MCP_ENABLED" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="230" height="90" as="geometry"/></mxCell><mxCell id="e0" value="add connector" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="claude" target="consent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="token" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="consent" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="admin" target="scopes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="admin" target="never"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="no sign-in" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="readers" target="public"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="revoke" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="revoke" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell></root></