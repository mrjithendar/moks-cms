<mxfile host="drawio" type="device"><diagram id="ml-model-or-rule" name="Model or rule? (ML models)"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" page="0" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Model or rule? (ML models)" style="text;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="start" value="A number on the site&#10;(priority, decay, intent...)" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="200" height="60" as="geometry"/></mxCell><mxCell id="ovr" value="Override&#10;setting" style="rhombus;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="130" height="100" as="geometry"/></mxCell><mxCell id="rule" value="Use the rule" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="30" width="180" height="50" as="geometry"/></mxCell><mxCell id="fresh" value="Output fresh?&#10;(within 14 days)" style="rhombus;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="160" height="110" as="geometry"/></mxCell><mxCell id="model" value="Use the model&#10;(labelled model vN)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="180" height="55" as="geometry"/></mxCell><mxCell id="stale" value="Rule&#10;(stale model output)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="180" height="55" as="geometry"/></mxCell><mxCell id="active" value="Active version?&#10;(beat the rule on&#10;held-out data)" style="rhombus;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;