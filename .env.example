# Most options below can also be managed in the admin, where a saved value overrides this file / the
# Kubernetes Secret, on the admin page each option belongs to: Integrations (Google/GitHub sign-in, Turnstile,
# IndexNow, verification, GA4, AdSense, consent, ads.txt, Gemini key and limits, video generation), Bookings
# (Cal.com webhook), Payments (Razorpay), Storage (R2/S3, video destinations), Email, and Users (members-only
# preview, avatar limits). Only database, Redis, auth/encryption secrets, SITE_URL, APP_ENV,
# the bootstrap token and start-up options (logging, OTel, metrics) must be set here.

# Copy to .env.local for local development. No secrets are needed in Phase 2.

# Deployment environment. Only "production" may be indexed by search engines;
# every other value adds noindex (meta tag at build time, X-Robots-Tag at request time).
APP_ENV=development

# Canonical origin used for canonical URLs, sitemaps, feeds and JSON-LD. No trailing slash.
SITE_URL=https://jithendar.com
# Optional: the customer this deployment belongs to, used in report storage keys (reports/<tenant>/<site>/…). Default: the site's host.
# MOKS_TENANT_ID=

# Where the visitor's address and country come from (src/lib/client-ip.ts; rate limits, audit log, paid-call currency).
# cloudflare (default): CF-Connecting-IP / CF-IPCountry, used only when the request came from one of Cloudflare's
# addresses (or the gateway cannot see the sender). gateway: no Cloudflare proxy in front; its headers are ignored.
# TRUSTED_EDGE=cloudflare
# Replaces the built-in list of Cloudflare ranges (https://www.cloudflare.com/ips/), comma-separated CIDRs.
# CLOUDFLARE_IP_RANGES=

# Which folder in sites/ to serve (scripts/use-site.mjs; default jithendar.com):
# SITE=jithendar.com

# Optional: read content from another directory (tests use tests/fixtures/content).
# CONTENT_DIR=

# --- Cross-replica cache invalidation (src/lib/cache-bus.ts). Optional. ---
# Pub/sub only (channel jithendar:invalidate, messages {kind, origin}); stores no data in Redis/Valkey. In production
# it comes from Secret redis-site-cachebus-credentials (key uri, ACL user site-cachebus; docs/redis-site-cachebus.md).
# Do NOT use REDIS_URL for this: REDIS_URL also moves sessions, rate limits and API keys to Redis.
# Unset: each process's caches converge within their TTL.
# CACHE_BUS_REDIS_URL=redis://site-cachebus:replace-me@localhost:6379

# --- Cloudflare cache purging (or Admin → Cache → Cloudflare settings). Requires manual configuration. ---
# Zone ID (dashboard → domain → Overview) and an API token with only Zone → Cache Purge → Purge on that zone.
# Used by the admin bar's Cache menu, Admin → Cache and purge on publish (src/lib/cdn-purge.ts). Unset: Cloudflare is
# never purged by the site. CLOUDFLARE_PURGE_ON_PUBLISH: related (default: the changed page and the pages that list
# it; site-wide changes purge everything), everything, or off.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_PURGE_ON_PUBLISH=related

# --- Media storage: Cloudflare R2 (S3-compatible API). Server-side only; never prefix with NEXT_PUBLIC_. ---
# Objects are written to jithendar/www/media/{type}/{yyyy}/{mm}/{id}.{ext} inside this bucket.
# Without these, an admin can configure R2 under Admin → Settings → Media & storage instead (stored encrypted in
# Postgres).
# R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# R2_BUCKET=jithendar-media
# R2_ACCESS_KEY_ID=replace-me
# R2_SECRET_ACCESS_KEY=replace-me
# Optional public delivery domain connected to the bucket (large video/audio/PDF redirect here):
# R2_PUBLIC_BASE_URL=https://media.jithendar.com
# Optional API endpoint override (EU jurisdiction bucket, or a local S3 emulator for development):
# R2_ENDPOINT=https://0123456789abcdef0123456789abcdef.eu.r2.cloudflarestorage.com

# --- "Generate image" in the editor: Gemini API (server-side only). Normally set in Settings → AI & models ---
# --- (key encrypted in the database). These variables are a fallback used until that is saved.          ---
# GEMINI_API_KEY=replace-me
# Model code from https://ai.google.dev/gemini-api/docs/models (an image-generation model).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=1K                      # 512 | 1K | 2K | 4K (model-dependent)
# GEMINI_IMAGE_TIMEOUT_MS=90000
# GEMINI_IMAGE_USER_HOURLY_LIMIT=10
# GEMINI_IMAGE_USER_CONCURRENCY=1
# GEMINI_IMAGE_DAILY_LIMIT=50               # whole site, per rolling 24 hours
# Video generation (editor → Generate → Video). Requires manual configuration: off until GEMINI_VIDEO_MODEL is set.
# Uses GEMINI_API_KEY; also editable in Admin → Settings → AI & models → Video generation.
# GEMINI_VIDEO_MODEL=                        # a Veo model code from ai.google.dev
# GEMINI_VIDEO_RESOLUTION=720p               # optional; sent only when set
# GEMINI_VIDEO_SECONDS=                      # optional clip length; model default when empty
# GEMINI_VIDEO_USER_HOURLY_LIMIT=3
# GEMINI_VIDEO_DAILY_LIMIT=10                # whole site, per rolling 24 hours
# GEMINI_VIDEO_TIMEOUT_MS=600000
# Members-only articles: how much signed-out readers see by default (per-post override in the editor).
# MEMBERS_PREVIEW_PERCENT=30                 # 5–95; also Admin → Users → Members-only articles
# Video destinations (where an inserted generated video goes). Requires manual configuration; also editable in
# Admin → Settings → Media & storage → Video destinations. The editor offers only destinations that are on and
# complete.
# VIDEO_DEST_R2_DISABLED=true                # this site's media library is on unless disabled
# CF_STREAM_ENABLED=true
# CF_STREAM_ACCOUNT_ID=
# CF_STREAM_API_TOKEN=                       # token with Stream: Edit only
# CF_STREAM_CUSTOMER_CODE=                   # the code in customer-<code>.cloudflarestream.com
# MUX_ENABLED=true
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# BUNNY_STREAM_ENABLED=true
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=                      # the Stream library's own key

# Local development without DATABASE_URL uses an embedded database in .data/pglite.
# PGLITE_DIR=.data/pglite
# Seconds before a connection attempt to Postgres (DATABASE_URL) gives up. Default 10.
# DATABASE_CONNECT_TIMEOUT_SECONDS=10

# --- Search engines, analytics and ads (public identifiers, not secrets; runtime, no rebuild) ----------
# In Kubernetes these come from the optional ConfigMap jithendar-com-public (scripts/set-public-config.sh).
# HTML-tag verification (prefer DNS verification for Google; see docs/SEO_ANALYTICS_ADS.md):
# GOOGLE_SITE_VERIFICATION=token-from-search-console
# BING_SITE_VERIFICATION=token-from-bing-webmaster-tools
# Google Analytics 4 (production only; never loaded on /admin, /login, /account, /setup, /preview):
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Razorpay paid calls on /hire-me (or set them in Admin → Payments → Razorpay payments). Requires manual configuration.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Google AdSense (production only; ADSENSE_TEST_MODE=true shows Google test ads in other environments):
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# ADSENSE_SLOT_ARTICLE_END=0000000000
# ADSENSE_TEST_MODE=false
# Exact ads.txt line(s) from your AdSense account; "\n" separates lines. Unset → /ads.txt returns 404.
# ADS_TXT=google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
# Consent Mode default: regional (denied in EEA/UK/CH until consent) or strict (denied everywhere).
# CONSENT_DEFAULT=regional
# IndexNow key (8–128 of a-z A-Z 0-9 -), served at /<key>.txt; submissions only in production:
# INDEXNOW_KEY=generate-with-openssl-rand-hex-16

# --- Hybrid RAG (moks-rag, docs/RAG.md): published posts synced to rag-api's collection in the background. ---
# --- Off until RAG_BEARER_TOKEN is set (here, or Settings → Integrations → Hybrid RAG). Server-side only.     ---
# Local development against the cluster: kubectl -n rag port-forward svc/rag-api 8000:8000
# RAG_API_URL=http://rag-api.rag.svc.cluster.local:8000
# RAG_BEARER_TOKEN=
# RAG_COLLECTION=cms_content
# RAG_SERVICE_NAME=moks-cms

# --- Social sign-in (server-side only; never prefix with NEXT_PUBLIC_). Normally managed in Admin →      ---
# --- Integrations; these variables apply to a provider until it is saved there. A provider's button     ---
# --- appears only when both its ID and secret are set. Callback: {SITE_URL}/api/auth/callback/{provider}. ---
# Local development: set SITE_URL=http://localhost:3000 and BETTER_AUTH_SECRET (any 32+ random characters).
# In Kubernetes: scripts/set-oauth-config.sh. Setup steps: docs/AUTH.md.
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# GITHUB_CLIENT_ID=replace-me
# GITHUB_CLIENT_SECRET=replace-me

# Avatar uploads (stored in R2 at jithendar/www/media/images/avatars/{user-id}/{id}.webp, re-encoded to 512 px WebP):
# AVATAR_MAX_BYTES=2097152          # upload size limit (64 KB – 10 MB)
# AVATAR_MAX_DIMENSION=4096         # largest accepted side in pixels
# AVATAR_MIN_DIMENSION=64           # smallest accepted side in pixels

# --- Housekeeping (src/lib/retention.ts) -----------------------------------------------------------------
# Finished jobs (30 days) and expired rate-limit counters (2 days) are removed daily. Audit entries are kept for ever
# unless this is set (30 or more): entries older than that many days are then removed too.
# AUDIT_LOG_RETENTION_DAYS=365

# --- Email ------------------------------------------------------------------------------------------------
# Choose SMTP, Mailgun or Amazon SES in Admin → Settings → Email (secrets are stored encrypted there).
# Until an admin saves a choice, this SMTP fallback is used when both are set (smtp:// or smtps:// only):
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Jithendar.com <no-reply@jithendar.com>
# Amazon SES with "the server's AWS credentials" uses the AWS SDK default chain, e.g.:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Python practice (/python-practice; docs/PYTHON_PRACTICE.md) -----------------------------------------
# Code execution service (kubernetes/practice-executor-*.yaml). Both are required, and execution must also be switched on in
# Admin → Python practice → Settings. Requires manual configuration (docs/PYTHON_PRACTICE_EXECUTOR.md).
# PRACTICE_EXECUTOR_URL=http://practice-executor.jithendar
# PRACTICE_EXECUTOR_TOKEN=replace-me-64-hex-characters
# Key for the pseudonymous user ids sent to the executor (defaults to a hash of SETTINGS_ENCRYPTION_KEY).
# PRACTICE_USER_HASH_KEY=
# AI tutor fallback keys when none is saved in the admin (Bedrock uses AWS credentials instead).
# OPENAI_API_KEY=

# --- SEO intelligence platform (/admin/seo; docs/seo/MANUAL_SETUP.md). Server-side only. ----------------
# Google service-account JSON key (raw or base64). In Kubernetes: Secret jithendar-com-env via scripts/set-seo-config.sh.
# Without it every SEO view shows "Disconnected". Never commit a real key.
# GOOGLE_SEO_SERVICE_ACCOUNT_JSON=
# Properties (Admin → SEO → Settings override these): domain property or URL-prefix property, and the numeric GA4 id.
# SEO_GSC_PROPERTY=sc-domain:jithendar.com
# SEO_GA4_PROPERTY_ID=123456789
# Optional PageSpeed Insights key (only used when enabled in Settings):
# PAGESPEED_API_KEY=
# Optional DataForSEO API credentials (docs/seo/DATAFORSEO.md; pay as you go): search volume, keyword difficulty, live
# Google ranks and backlinks. In Kubernetes: Secret jithendar-com-env via scripts/set-dataforseo-config.sh. Nothing is
# bought until DataForSEO is also switched on in Settings → Data sources, and never above its monthly cap.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# Optional AI visibility keys (docs/seo/AI_VISIBILITY.md; scripts/set-ai-visibility-config.sh). Claude uses
# ANTHROPIC_API_KEY; ChatGPT uses OPENAI_API_KEY and Gemini GEMINI_API_KEY (both also LLM fallbacks above).
# PERPLEXITY_API_KEY=

# --- Promotion (/admin/promotion; docs/seo/PROMOTION.md). Server-side only. ------------------------------------
# Reddit API "script" app (https://www.reddit.com/prefs/apps), used read-only to find threads on your subjects.
# In Kubernetes: Secret jithendar-com-env via scripts/set-reddit-config.sh. Without them Promotion still works from
# the articles and Search Console data; the page says Reddit "Requires manual configuration". Never commit real values.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Optional; Reddit asks for <platform>:<app id>:<version> (by /u/<username>).
# REDDIT_USER_AGENT=web:com.jithendar.promotion:v1.0 (by /u/your-username)

# --- SEO platform v2: Claude-drafted changes (docs/seo/REVIEW_WORKFLOW.md, MANUAL_SETUP.md). Server-side only. ---
# Anthropic API key from a Kubernetes Secret (jithendar-com-env). Never stored in the database, never logged.
# Without it nothing is drafted; the review queue says "Needs credentials".
# ANTHROPIC_API_KEY=
# Models (Settings → Drafts may override): drafting and cheap classification (search intent).
# SEO_DRAFT_MODEL=claude-sonnet-5-5
# SEO_CLASSIFY_MODEL=claude-haiku-5-5
# There is no LLM spend limit here. The one LLM budget is set in Admin → Settings → AI & models → LLM providers &
# budget and is kept
# and enforced by the seo-agent. SEO_LLM_MONTHLY_BUDGET_USD is no longer read.
# Optional price override if Anthropic list prices change, USD per million tokens:
# SEO_LLM_PRICES_JSON={"claude-sonnet-5-5":{"input":2,"output":10}}
# Search-engine submission kill switch (IndexNow + Search Console sitemap resubmit + URL Inspection checks).
# Unset: on only when APP_ENV=production.
# SEO_SUBMISSION_ENABLED=false
